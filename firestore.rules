rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // users: everyone can read, only the user can write
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // usernames: everyone can read, write is allowed only if creating
    match /usernames/{username} {
      allow read: if isAuth();
      // Allow create if auth matches the uid in the payload (for registration)
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false; // Users shouldn't change usernames easily, or implement separately
    }

    // chats (direct messages)
    match /chats/{chatId} {
      // Allow read if user is in participants list
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      // Allow create if the user adds themselves to participants
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      // Allow update if they were in the chat
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      // Allow delete if they are in the chat
      allow delete: if isAuth() && request.auth.uid in resource.data.participants;

      // Messages inside chats
      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // User can only send messages as themselves
        allow create: if isAuth() 
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.userId == request.auth.uid;
        // User can only edit/delete their own messages
        allow update, delete: if isAuth() 
                              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                              && resource.data.userId == request.auth.uid;
      }
    }

    // groups
    match /groups/{groupId} {
      // Allow read if user is a participant
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      // Allow create if the user is the creator and adds themselves
      allow create: if isAuth() 
                    && request.resource.data.createdBy == request.auth.uid
                    && request.auth.uid in request.resource.data.participants;
      
      // Update logic:
      // If updating participants or name, must be Admin (createdBy), EXCEPT if removing oneself (leaving group)
      allow update: if isAuth() && (
        request.auth.uid == resource.data.createdBy // Admin can do anything
        || (
           // Non-admin can only remove themselves from participants, nothing else
           request.auth.uid in resource.data.participants 
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
           && request.auth.uid in resource.data.participants
           && !(request.auth.uid in request.resource.data.participants)
        )
        || (
           // Allow updating lastMessage, lastMessageSender, typing, lastUpdated for all participants
           request.auth.uid in resource.data.participants
           && request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage', 'lastMessageSender', 'lastUpdated', 'typing'])
        )
      );
      
      // Delete group: Admin only
      allow delete: if isAuth() && request.auth.uid == resource.data.createdBy;

      // Messages inside groups
      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participants;
        allow create: if isAuth() 
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participants
                      && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAuth() 
                              && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participants
                              && resource.data.userId == request.auth.uid;
      }
    }
  }
}
