rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Function to check message schema
    function isValidMessage() {
      let data = request.resource.data;
      return data.keys().hasOnly(['text', 'userId', 'userName', 'timestamp', 'imageUrl', 'read', 'edited'])
          && data.text is string
          && data.text.size() <= 2000
          && data.userId == request.auth.uid;
    }

    // ---- Internal server-only collection ----
    // Rate-limit records are written only by Cloud Functions (admin SDK bypasses rules)
    // But we explicitly deny any client access.
    match /_rateLimits/{docId} {
      allow read, write: if false;
    }

    // users: everyone can read, only the user can write their own doc
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() 
                   && request.auth.uid == userId
                   && request.resource.data.keys().hasAny(['username', 'createdAt', 'avatarUrl', 'status', 'lastSeen', 'fcmToken']);
    }

    // usernames: публичное чтение (нужно при логине до авторизации), создание только своего, удаление/обновление запрещено
    match /usernames/{username} {
      allow read: if true;  // Нужен неаутентифицированный доступ для поиска email при логине
      allow create: if isAuth() 
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['email', 'uid']);
      allow update, delete: if false; 
    }

    // chats (direct messages)
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
      allow delete: if isAuth() && request.auth.uid in resource.data.participants;

      // Messages inside chats
      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth() 
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && isValidMessage();
        allow update: if isAuth() 
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'read'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000;
        allow delete: if isAuth() 
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && resource.data.userId == request.auth.uid;
      }
    }

    // groups
    match /groups/{groupId} {
      // Allow read if user is a participant
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      // Creation, deletion and metadata updates are handled by Cloud Functions (admin SDK)
      allow create: if false;
      allow delete: if false;
      
      // Allow updating only messaging metadata (lastMessage, typing, etc.)
      allow update: if isAuth() 
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastMessage', 'lastMessageSender', 'lastUpdated', 'typing']);

      // Messages inside groups
      match /messages/{messageId} {
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participants;
        allow create: if isAuth() 
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participants
                      && isValidMessage();
        allow update: if isAuth() 
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participants
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'read'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000;
        allow delete: if isAuth() 
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.participants
                      && resource.data.userId == request.auth.uid;
      }
    }
  }
}
