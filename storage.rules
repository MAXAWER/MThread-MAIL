rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{fileName} {
      allow get: if true;
      allow list: if false;
      // filename must start with uid
      allow write: if request.auth != null 
                   && fileName.matches(request.auth.uid + '_.*')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /chat_images/{chatId}/{fileName} {
      // allow get if true because we share URL. Strictly we should check chat membership but URLs are hard to guess.
      allow get: if true;
      allow list: if false;
      // allow upload if auth is present and image is valid
      allow write: if request.auth != null 
                   && fileName.matches('.*') // Any filename is okay, but must be in chat folder
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
